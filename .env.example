# Copy to .env and fill in. Never commit .env.

# ---- server ----
SITE_ADDRESS=assistant.odea.local
SCHOOL_TIME_ZONE=America/Los_Angeles
POSTGRES_PASSWORD=change-me

# ---- models ----
# Target: the on-site model answers (PRIMARY_MODEL=ollama), with Claude as a
# fallback when it's down. Until the GPU server arrives: PRIMARY_MODEL=claude.
PRIMARY_MODEL=claude
ALLOW_CLAUDE_FALLBACK=true
# On-site model through Ollama (start compose with --profile local).
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3-vl:8b
# OLLAMA_VISION=true
# Claude. Create a key at console.anthropic.com.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# ---- who can use it ----
# Launch is staff only: anyone below this role is turned away.
ASSISTANT_MIN_ROLE=staff
RATE_LIMIT_PER_HOUR=60

# ---- web sign-in (Microsoft 365 / Entra ID through oauth2-proxy) ----
TRUST_PROXY_AUTH=true
DEFAULT_ROLE=public
# Entra ID group OBJECT IDS (comma-separated), from the token's "groups" claim.
STAFF_GROUPS=
# STUDENT_GROUPS=
# ADMIN_USERS=it-person@odea.org
# The web sign-in's Entra ID app registration (can be the same app as the Teams bot).
WEB_SSO_CLIENT_ID=
WEB_SSO_CLIENT_SECRET=
# 32 random bytes, base64: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WEB_SSO_COOKIE_SECRET=

# ---- BellForge ----
# Long random string; the BellForge desktop app sends it when pushing calendar data.
BELLFORGE_SYNC_TOKEN=
# Point at BellForge's own file to stay in sync with it (default: bundled snapshot).
# BELLFORGE_SCHEDULES_PATH=/bellforge/schools/odea/schedules.json

# ---- Microsoft Teams (optional; docs/TEAMS.md) ----
TEAMS_ENABLED=false
# The bot's Entra ID app registration (names are what the Microsoft 365 Agents SDK reads).
# tenantId is also used by the web sign-in above.
tenantId=
clientId=
clientSecret=
# Staff-only launch: either list the staff group below, or limit who can install
# the app in the Teams admin center and set TEAMS_DEFAULT_ROLE=staff.
TEAMS_DEFAULT_ROLE=student
# Entra ID group object ids (comma-separated); needs GroupMember.Read.All.
# TEAMS_STAFF_GROUP_IDS=
# TEAMS_STUDENT_GROUP_IDS=
CLOUDFLARE_TUNNEL_TOKEN=
